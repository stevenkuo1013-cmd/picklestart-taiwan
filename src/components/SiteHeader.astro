---
const path = Astro.url.pathname;
---

<header class="site-header site-header-v3">
  <div class="site-header-inner">
    <a class="site-brand-v3" href="/" aria-label="PickleStart Taiwan 首頁">
      <img src="/brand/picklestart-mark.svg" alt="PickleStart Taiwan" />
    </a>

    <nav class="site-nav" aria-label="主要導覽">
      <a class:list={[{ active: path === "/" }]} href="/">首頁</a>
      <a class:list={[{ active: path.startsWith("/guide") }]} href="/guide">新手指南</a>
      <a
        class:list={[{ active: path === "/builder/" }]}
        href="/builder?from=nav"
        data-analytics-event="site_builder_clicked"
        data-analytics-detail-event="site_builder_source"
        data-analytics-placement="nav"
      >
        Starter Kit 工具
      </a>
      <a class:list={[{ active: path === "/how-we-recommend/" }]} href="/how-we-recommend">
        推薦方式
      </a>
      <a class:list={[{ active: path === "/about/" }]} href="/about">
        關於我們
      </a>
    </nav>

    <a
      class="header-cta"
      href="/builder?from=header"
      data-analytics-event="site_builder_clicked"
      data-analytics-detail-event="site_builder_source"
      data-analytics-placement="header_cta"
    >
      開始配裝備 <span>→</span>
    </a>
  </div>
</header>
