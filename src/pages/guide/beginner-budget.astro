---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideBreadcrumbs from "../../components/GuideBreadcrumbs.astro";
import GuideFAQ from "../../components/GuideFAQ.astro";
import GuideRelatedLinks from "../../components/GuideRelatedLinks.astro";
import GuideEndCTA from "../../components/GuideEndCTA.astro";
import { buildStarterKit } from "../../logic/recommendation";
import type { BuilderInput } from "../../types";
import "../../styles/guide.css";

const twoPersonInput: BuilderInput = {
  experience: "first_time",
  requestedPaddles: 2,
  venue: "outdoor_court",
  existingEquipment: {
    paddles: 0,
    balls: false,
    badmintonShoes: true,
    tennisShoes: false,
    courtShoes: false,
    netAvailable: true
  },
  budget: 3000,
  goal: "casual"
};

const seriousInput: BuilderInput = {
  experience: "serious",
  requestedPaddles: 1,
  venue: "indoor",
  existingEquipment: {
    paddles: 0,
    balls: false,
    badmintonShoes: false,
    tennisShoes: false,
    courtShoes: false,
    netAvailable: true
  },
  budget: 8000,
  goal: "competitive"
};

const twoPersonResult = buildStarterKit(twoPersonInput);
const seriousResult = buildStarterKit(seriousInput);

const money = (value: number) =>
  new Intl.NumberFormat("zh-TW").format(Math.round(value));

const faqItems = [
  {
    question: "有 NT$5,000 預算就應該全部花完嗎？",
    answer: "不用。預算是上限，不是目標；如果你已有鞋、球或球網，剩下的錢沒有必要為了「用完預算」硬升級配件。"
  },
  {
    question: "為什麼兩個新手需要的預算可能差很多？",
    answer: "差異通常來自需要幾支球拍、已有裝備、室內或戶外場地，以及現場是否提供球網。",
    href: "/guide/beginner-equipment",
    linkLabel: "先看裝備優先順序"
  },
  {
    question: "哪個項目最容易讓新手預算突然變高？",
    answer: "如果要在公園或空地自行架場，攜帶式球網可能成為很大的額外支出；第一次體驗可優先找已有球網的場地。"
  }
];

const relatedItems = [
  {
    href: "/guide/beginner-equipment",
    title: "第一次要買什麼？",
    description: "先把必要與可延後分開"
  },
  {
    href: "/guide/badminton-shoes",
    title: "已有鞋要重買嗎？",
    description: "省下最容易重複花的預算"
  },
  {
    href: "/guide/first-game",
    title: "第一次去球場",
    description: "先確認場地提供什麼"
  }
];

---

<BaseLayout
  pageType="article"
  datePublished="2026-09-29"
  dateModified="2026-09-29"
  title="匹克球新手預算：第一次玩要花多少？NT$2,000–8,000 怎麼配｜PickleStart Taiwan"
  description="匹克球新手第一次要花多少錢？從 NT$2,000、3,000、5,000 到 8,000，拆解球拍、球、鞋與球網優先順序，並依已有裝備估算實際 Starter Kit。"
  breadcrumbs={[
    { name: "首頁", href: "/" },
    { name: "匹克球新手指南", href: "/guide" },
    { name: "新手預算指南", href: "/guide/beginner-budget" }
  ]}
>
  <article class="guide-page">
    <GuideBreadcrumbs current="新手預算指南" />
    <div class="guide-hero">
      <p class="eyebrow">Beginner Budget Guide</p>
      <h1>第一次玩匹克球，要花多少錢才合理？</h1>

      <p class="guide-lead">
        沒有一個所有人都適用的「新手預算」。兩個人已有羽球鞋、
        去固定戶外球場，和四個人要在公園自己架球網，成本可以差非常多。
        所以與其先問「球拍多少錢」，更應該先問「整套我需要什麼」。
      </p>

      <div class="guide-cta-row">
        <a
          class="primary-button"
          href="/builder?from=guide_inline&article=beginner-budget"
          data-analytics-event="guide_builder_clicked"
          data-analytics-detail-event="guide_builder_source"
          data-analytics-placement="hero_inline"
          data-analytics-article="beginner-budget"
        >
          算我的實際 Starter Kit 預算 →
        </a>
        <span>使用目前商品 catalog 即時計算</span>
      </div>
    </div>

      <figure class="guide-cover-image">
    <img src="/images/guide-budget.webp" alt="匹克球新手裝備與場地鞋" loading="eager" />
  </figure>

<section class="guide-budget-rule">
      <span>PickleStart 的預算邏輯</span>
      <strong>總預算 − 必要非球拍成本 = 可用球拍預算</strong>
      <strong>可用球拍預算 ÷ 還缺的球拍數量 = 單支球拍預算</strong>
    </section>

    <section class="guide-section">
      <p class="guide-step">NT$2,000 左右</p>
      <h2>適合：一個人先體驗，或你已經有部分裝備</h2>
      <p>
        這個預算最適合「先開始」而不是「一次買完整」。
        如果你已經有可沿用的場地鞋、場地有球網，而且只需要一支入門拍，
        通常比較有機會控制在這個範圍。
      </p>

      <div class="guide-note">
        <strong>這個預算最怕什麼？</strong>
        <p>
          同時需要多支球拍、鞋子或攜帶式球網。這些需求一疊加，
          就不應該為了守住 NT$2,000 而硬買不合理的產品。
        </p>
      </div>
    </section>

    <section class="guide-section">
      <p class="guide-step">NT$3,000 左右</p>
      <h2>適合：兩人休閒入門，但已有合適鞋子與固定場地</h2>

      <p>
        例如兩個第一次玩的使用者，到戶外固定球場、已經有羽球鞋，
        目前 PickleStart 的 catalog 與 Recommendation Engine 會估出：
      </p>

      <div class="dynamic-budget-card">
        <span>兩人休閒示例</span>
        <strong>
          NT${money(twoPersonResult.estimatedMinSpend)}
          –
          NT${money(twoPersonResult.estimatedMaxSpend)}
        </strong>
        <p>
          球拍 × 2 + 小包裝戶外球，沿用現有羽球鞋，不買球網。
        </p>
      </div>

      <p>
        這也是為什麼「總預算 NT$3,000」不代表一定要找到一支 NT$3,000 的球拍。
        對兩個人來說，預算要先分給兩支球拍與球。
      </p>
    </section>

    <section class="guide-section">
      <p class="guide-step">NT$5,000 左右</p>
      <h2>適合：開始固定打，希望第一支拍可以用久一點</h2>

      <p>
        預算提高之後，可以開始考慮較完整的入門或中階球拍，
        但仍然不代表一定要把 NT$5,000 全部花完。
        如果你已有鞋、球網與球，剩餘預算應該優先花在最會影響使用體驗的裝備上。
      </p>
    </section>

    <section class="guide-section">
      <p class="guide-step">NT$8,000 左右</p>
      <h2>適合：認真固定打，並且還缺場地鞋</h2>

      <p>
        例如一名認真訓練的室內玩家，沒有場地鞋、需要一支較高階球拍與室內球，
        目前系統估算為：
      </p>

      <div class="dynamic-budget-card">
        <span>認真訓練示例</span>
        <strong>
          NT${money(seriousResult.estimatedMinSpend)}
          –
          NT${money(seriousResult.estimatedMaxSpend)}
        </strong>
        <p>
          較高 tier 球拍 + 室內球 + 場地鞋；即使預算是 NT$8,000，
          也不會為了花完預算而自動升級更多配件。
        </p>
      </div>
    </section>

    <section class="guide-section">
      <h2>真正容易讓預算爆掉的是球網</h2>
      <p>
        如果你選擇公園或空地自行架場，而且現場沒有球網，
        portable net 可能直接成為整套裝備中非常大的支出。
        對第一次體驗的人，先找已有球網的公共場地通常比「硬買完整自架套裝」更有效率。
      </p>
    </section>


    <GuideFAQ items={faqItems} />

    <GuideRelatedLinks items={relatedItems} />

    <GuideEndCTA
      heading="你的真正預算，不是網路上的平均數字。"
      text="讓 Builder 先扣掉你已經有的，再依場地與需求估出 Starter Kit 的合理價格帶。"
      buttonText="算我的 Starter Kit 預算"
    />

    <section class="guide-source-note">
      <h2>價格說明</h2>
      <p>
        本頁動態示例使用網站目前的商品 catalog 與 Recommendation Engine 產生，
        商品價格與供貨仍可能變動，實際價格以外部商店當下頁面為準。
      </p>
    </section>
  </article>
</BaseLayout>
