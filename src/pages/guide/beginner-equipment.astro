---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideBreadcrumbs from "../../components/GuideBreadcrumbs.astro";
import GuideFAQ from "../../components/GuideFAQ.astro";
import GuideRelatedLinks from "../../components/GuideRelatedLinks.astro";
import GuideEndCTA from "../../components/GuideEndCTA.astro";
import "../../styles/guide.css";

const faqItems = [
  {
    question: "第一次打匹克球一定要買球網嗎？",
    answer: "不一定。如果固定球場或球館已經有球網，就沒有必要重複購買；只有自行架場而現場沒有網時才需要。"
  },
  {
    question: "已有羽球鞋還需要買匹克球鞋嗎？",
    answer: "不一定。鞋況良好、抓地與側向支撐合適時，第一次通常可以先沿用，再依使用頻率決定是否升級。",
    href: "/guide/badminton-shoes",
    linkLabel: "看鞋款判斷方式"
  },
  {
    question: "第一次需要直接買高階球拍嗎？",
    answer: "通常不用。先確認自己會不會固定打、偏好的手感與場地，再升級通常比第一次就買高階款更有效率。"
  }
];

const relatedItems = [
  {
    href: "/guide/beginner-budget",
    title: "新手預算怎麼抓？",
    description: "從整套裝備算，不只看球拍"
  },
  {
    href: "/guide/badminton-shoes",
    title: "羽球鞋可以嗎？",
    description: "已有鞋款先判斷能不能沿用"
  },
  {
    href: "/guide/first-game",
    title: "第一次去球場",
    description: "確認真正需要帶的東西"
  }
];

---

<BaseLayout
  pageType="article"
  datePublished="2026-09-29"
  dateModified="2026-09-29"
  title="匹克球新手裝備清單：第一次要買什麼、哪些先不用｜PickleStart Taiwan"
  description="第一次打匹克球要買什麼？整理球拍、球、鞋子、球網的購買優先順序，告訴你哪些可以沿用、哪些第一次先不用買，避免一次買太多。"
  breadcrumbs={[
    { name: "首頁", href: "/" },
    { name: "匹克球新手指南", href: "/guide" },
    { name: "新手裝備清單", href: "/guide/beginner-equipment" }
  ]}
>
  <article class="guide-page">
    <GuideBreadcrumbs current="新手裝備清單" />
    <div class="guide-hero">
      <p class="eyebrow">Beginner Equipment Guide</p>
      <h1>第一次玩匹克球要買什麼？</h1>
      <p class="guide-lead">
        如果你只是準備第一次上場，通常不需要一次把球拍、鞋子、球袋、
        球網全部買齊。先看場地提供什麼、你已經有什麼，再決定真正缺的東西。
      </p>

      <div class="guide-cta-row">
        <a
          class="primary-button"
          href="/builder?from=guide_inline&article=beginner-equipment"
          data-analytics-event="guide_builder_clicked"
          data-analytics-detail-event="guide_builder_source"
          data-analytics-placement="hero_inline"
          data-analytics-article="beginner-equipment"
        >
          60 秒建立我的裝備清單 →
        </a>
        <span>免費 · 不需註冊</span>
      </div>
    </div>

      <figure class="guide-cover-image">
    <img src="/images/guide-equipment.webp" alt="匹克球拍、黃色匹克球與球網" loading="eager" />
  </figure>

<section class="guide-summary">
      <div>
        <span class="guide-summary-label">通常先準備</span>
        <strong>球拍 + 對應場地的球</strong>
      </div>
      <div>
        <span class="guide-summary-label">可以先沿用</span>
        <strong>合適的羽球鞋 / 網球鞋</strong>
      </div>
      <div>
        <span class="guide-summary-label">通常先不用</span>
        <strong>高階球拍、球拍袋、球網</strong>
      </div>
    </section>

    <section class="guide-section">
      <p class="guide-step">01</p>
      <h2>球拍：第一支不需要直接買最高階</h2>
      <p>
        對第一次體驗或剛開始打幾次的人，重點是握把舒服、重量不會讓你連續揮動很吃力，
        以及價格符合你目前的投入程度。新手沒有必要把「最貴」當成「最適合」。
      </p>

      <div class="guide-note">
        <strong>PickleStart 的做法</strong>
        <p>
          我們會先扣掉球、球網與必要裝備，再把剩餘預算分配給你真正還缺的球拍數量。
        </p>
      </div>
    </section>

    <section class="guide-section">
      <p class="guide-step">02</p>
      <h2>球：先確認室內還是戶外</h2>
      <p>
        室內球與戶外球的孔洞、硬度與環境適應設計不同。
        如果你連常用場地都還沒確定，不需要一次囤很多球，先買小包裝或確認場地再買比較合理。
      </p>
    </section>

    <section class="guide-section">
      <p class="guide-step">03</p>
      <h2>鞋：有合適的場地鞋，不一定要重買</h2>
      <p>
        匹克球包含不少左右移動、急停與轉向，所以鞋子的重點是抓地與側向支撐。
        如果你已經有狀況良好的羽球鞋、網球鞋或其他場地鞋，
        第一次體驗通常沒有必要只因為鞋面上沒有寫「Pickleball」就重新買一雙。
      </p>

      <a class="guide-inline-link" href="/guide/badminton-shoes">
        看完整的「羽球鞋可以打匹克球嗎？」→
      </a>
    </section>

    <section class="guide-section">
      <p class="guide-step">04</p>
      <h2>球網：先看場地有沒有，不要預設一定要買</h2>
      <p>
        如果你去的是固定匹克球場或球館，通常不需要自己準備完整球網。
        只有你打算在公園、空地等自行架設場地，而且現場沒有球網時，
        portable net 才會成為主要支出。
      </p>
    </section>

    <section class="guide-section">
      <p class="guide-step">05</p>
      <h2>哪些東西第一次可以先跳過？</h2>

      <div class="guide-skip-grid">
        <article>
          <strong>高階競賽球拍</strong>
          <p>先確認自己會不會固定打，再決定是否升級。</p>
        </article>
        <article>
          <strong>專用球拍袋</strong>
          <p>對第一次開始的人不是必要條件。</p>
        </article>
        <article>
          <strong>大量比賽球</strong>
          <p>先確認主要場地與使用頻率。</p>
        </article>
        <article>
          <strong>全尺寸攜帶球網</strong>
          <p>有現成球網的場地就不需要。</p>
        </article>
      </div>
    </section>


    <GuideFAQ items={faqItems} />

    <GuideRelatedLinks items={relatedItems} />

    <GuideEndCTA
      heading="最省錢的方法不是買最便宜，而是不要重複買。"
      text="配裝工具會把你已有的球拍、球、鞋與現場球網都算進去，再列出真正缺的項目。"
      buttonText="幫我整理裝備清單"
    />

    <section class="guide-source-note">
      <h2>資料說明</h2>
      <p>
        本頁依台灣公開的新手入門與器材資料整理。實際場館規定、
        商品供貨與價格可能變動；正式購買前仍應查看場館與商店最新資訊。
      </p>
    </section>
  </article>
</BaseLayout>
