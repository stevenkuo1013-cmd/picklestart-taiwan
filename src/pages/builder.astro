---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
const title = "Starter Kit Builder | PickleStart Taiwan";

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url.origin
);
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <meta
      name="description"
      content="回答 6 個問題，60 秒建立你的匹克球新手 Starter Kit。"
    />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="回答 6 個問題，60 秒建立你的匹克球新手 Starter Kit。"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_TW" />

  
    <style is:global>
      /* PRODUCT CARD 2.0 */
      .product-card-v2 {
        border: 1px solid #dce6e9;
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 14px 38px rgba(16, 36, 63, 0.055);
        overflow: hidden;
      }

      .product-card-v2.is-primary {
        border-color: rgba(8, 127, 165, 0.28);
        box-shadow: 0 16px 42px rgba(8, 127, 165, 0.08);
      }

      .product-card-v2.is-upgrade {
        border-color: rgba(8, 127, 165, 0.22);
        background:
          linear-gradient(
            145deg,
            rgba(238, 248, 251, 0.72),
            #ffffff 42%
          );
      }

      .product-card-v2.is-dedicated {
        border-color: rgba(16, 36, 63, 0.2);
      }

      .product-card-v2 .product-card-top {
        gap: 28px;
        align-items: flex-start;
      }

      .product-card-title-group {
        min-width: 0;
        flex: 1;
      }

      .product-card-v2 .product-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        margin-bottom: 12px;
      }

      .product-role-badge {
        display: inline-flex;
        min-height: 26px;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 800;
        line-height: 1.15;
      }

      .product-role-badge.role-primary {
        color: #10243f;
        background: #e2f52c;
      }

      .product-role-badge.role-upgrade {
        color: #075f7d;
        background: #e6f6fb;
        border: 1px solid #bce4ef;
      }

      .product-role-badge.role-alternative {
        color: #536579;
        background: #f2f5f6;
        border: 1px solid #e1e8ea;
      }

      .product-role-badge.role-dedicated {
        color: #ffffff;
        background: #087fa5;
      }

      .product-role-badge.role-value {
        color: #536579;
        background: #f7f3e8;
        border: 1px solid #e9e0ca;
      }

      .product-card-v2 h3 {
        margin-bottom: 7px;
        line-height: 1.35;
      }

      .product-positioning {
        margin: 0 0 8px;
        color: #087fa5;
        font-size: 0.96rem;
        font-weight: 750;
        line-height: 1.55;
      }

      .product-card-v2 .product-merchant {
        margin-top: 0;
      }

      .product-card-v2 .product-price {
        flex: 0 0 auto;
      }

      .product-card-v2 .product-price strong {
        white-space: nowrap;
      }

      .product-description {
        margin-top: 20px;
        color: #586a7d;
        line-height: 1.75;
      }

      .product-fit-block {
        margin-top: 20px;
        padding: 18px 20px;
        border-radius: 16px;
        background: #f8faf9;
        border: 1px solid #edf1ef;
      }

      .product-fit-heading {
        margin: 0 0 12px;
        color: #10243f;
        font-size: 0.8rem;
        font-weight: 850;
        letter-spacing: 0.04em;
      }

      .product-fit-list-v2 {
        display: grid;
        gap: 9px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .product-fit-list-v2 li {
        display: flex;
        gap: 9px;
        align-items: flex-start;
        color: #4f6174;
        line-height: 1.55;
      }

      .product-fit-list-v2 li > span:first-child {
        flex: 0 0 auto;
        color: #087fa5;
        font-weight: 900;
      }

      .product-card-v2 .product-card-footer {
        margin-top: 22px;
      }

      @media (max-width: 720px) {
        .product-card-v2 .product-card-top {
          display: block;
        }

        .product-card-v2 .product-price {
          margin-top: 14px;
        }

        .product-card-v2 .product-price strong {
          white-space: normal;
        }

        .product-fit-block {
          padding: 16px;
        }
      }
    </style>

  
    <style is:global>
      /* PRODUCT CARD 2.1 — compact & human copy */
      .product-card-v2 {
        padding: 26px 30px !important;
      }

      .product-card-v2 .product-meta {
        margin-bottom: 9px;
      }

      .product-card-v2 h3 {
        margin-top: 0;
        margin-bottom: 5px;
      }

      .product-card-v2 .product-positioning {
        margin-bottom: 6px;
      }

      .product-card-v2 .product-merchant {
        margin-bottom: 0;
        font-size: 0.94rem;
      }

      .product-card-v2 .product-fit-block {
        margin-top: 16px;
        padding: 15px 17px;
        border-radius: 15px;
      }

      .product-card-v2 .product-fit-heading {
        margin-bottom: 10px;
      }

      .product-card-v2 .product-fit-list-v2 {
        gap: 8px;
      }

      .product-card-v2 .product-fit-list-v2 li {
        color: #536579 !important;
        font-weight: 500 !important;
      }

      .product-card-v2 .product-fit-list-v2 li > span:last-child {
        color: #536579 !important;
      }

      .product-card-v2 .product-fit-list-v2 li > span:first-child {
        color: #087fa5 !important;
        font-weight: 900 !important;
      }

      .product-card-v2 .product-card-footer {
        margin-top: 17px;
        padding-top: 16px;
      }

      .product-card-v2 .product-verification {
        font-size: 0.88rem;
      }

      @media (max-width: 720px) {
        .product-card-v2 {
          padding: 22px 20px !important;
        }

        .product-card-v2 .product-fit-block {
          padding: 14px 15px;
        }
      }
    </style>

  
    <style is:global>
      /* PRODUCT OPTIONS 2.2 — category grouping & choice clarity */

      .product-choice-intro {
        display: grid;
        gap: 5px;
        margin: 4px 0 34px;
        padding: 18px 20px;
        border: 1px solid #d9e9ee;
        border-radius: 16px;
        background: #f5fafb;
      }

      .product-choice-intro strong {
        color: #10243f;
        font-size: 1rem;
      }

      .product-choice-intro span {
        color: #647487;
        line-height: 1.65;
      }

      .product-choice-group {
        margin-top: 42px;
      }

      .product-choice-group:first-of-type {
        margin-top: 0;
      }

      .product-choice-group + .product-choice-group {
        padding-top: 42px;
        border-top: 1px solid #e3eaec;
      }

      .product-choice-group-heading {
        margin-bottom: 18px;
      }

      .product-choice-eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #087fa5;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.12em;
      }

      .product-choice-title-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        align-items: center;
      }

      .product-choice-title-row h3 {
        margin: 0;
        color: #10243f;
        font-size: 1.55rem;
        line-height: 1.25;
      }

      .product-choice-title-row > span {
        display: inline-flex;
        align-items: center;
        min-height: 29px;
        padding: 4px 11px;
        border-radius: 999px;
        color: #10243f;
        background: #edf8b8;
        font-size: 0.82rem;
        font-weight: 800;
      }

      .product-choice-group-heading p {
        max-width: 720px;
        margin: 8px 0 0;
        color: #647487;
        line-height: 1.65;
      }

      .product-choice-list {
        display: grid;
        gap: 18px;
      }

      .product-choice-list > .product-card-v2 {
        margin: 0 !important;
      }

      .product-choice-list > .product-card-v2:first-child {
        box-shadow: 0 16px 42px rgba(16, 36, 63, 0.075);
      }

      .product-choice-list > .product-card-v2:not(:first-child) {
        box-shadow: 0 8px 24px rgba(16, 36, 63, 0.035);
      }

      .product-choice-list > .product-card-v2:not(:first-child) .product-link {
        box-shadow: none;
      }

      .product-card-v2 .product-verification {
        color: #8a98a6;
        font-size: 0.82rem !important;
      }

      @media (max-width: 720px) {
        .product-choice-intro {
          margin-bottom: 28px;
          padding: 16px;
        }

        .product-choice-group {
          margin-top: 34px;
        }

        .product-choice-group + .product-choice-group {
          padding-top: 34px;
        }

        .product-choice-title-row h3 {
          font-size: 1.35rem;
        }

        .product-choice-list {
          gap: 14px;
        }
      }
    </style>

  
    <style is:global>
      /* PRODUCT OPTIONS 2.2.1 — final polish */

      .product-choice-intro {
        margin-bottom: 28px;
        padding: 16px 18px;
      }

      .product-choice-group {
        margin-top: 34px;
      }

      .product-choice-group + .product-choice-group {
        padding-top: 34px;
      }

      .product-choice-group-heading {
        margin-bottom: 15px;
      }

      .product-choice-group-heading p {
        margin-top: 6px;
      }

      .product-choice-list {
        gap: 15px;
      }

      .product-card-v2 .product-verification {
        color: #9aa6b2 !important;
        font-size: 0.78rem !important;
        font-weight: 500 !important;
      }

      .product-card-v2 .product-card-footer {
        gap: 14px;
      }

      @media (max-width: 720px) {
        .product-choice-intro {
          margin-bottom: 24px;
          padding: 15px 16px;
        }

        .product-choice-group {
          margin-top: 28px;
        }

        .product-choice-group + .product-choice-group {
          padding-top: 28px;
        }

        .product-choice-list {
          gap: 12px;
        }
      }
    </style>

  
    <style is:global>
      /* EQUIPMENT STEP V2 */
      .equipment-or-bottom {
        margin-top: 8px;
      }

      .equipment-or-bottom span {
        color: #7b8997;
      }
    </style>

  
    <style is:global>
      /* EQUIPMENT STEP V2.1 - final polish */
      .equipment-or-bottom {
        margin-top: 12px;
        margin-bottom: 2px;
      }

      .equipment-or-bottom span {
        color: #657789 !important;
        font-size: 0.84rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.01em;
      }
    </style>


  <style is:global>
    /* PickleStart budget summary v2 */

    .budget-summary-v2 {
      --budget-navy: #10243f;
      --budget-teal: #087fa5;
      --budget-lime: #e2f52c;
      --budget-border: #dfe7eb;
      --budget-soft: #f5f8f7;

      width: 100%;
      padding: 28px;
      border: 1px solid var(--budget-border);
      border-radius: 28px;
      background: #ffffff;
      color: var(--budget-navy);
      box-shadow: 0 18px 45px rgba(16, 36, 63, 0.08);
    }

    .budget-summary-v2__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
    }

    .budget-summary-v2__eyebrow {
      color: var(--budget-teal);
      font-size: 0.86rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }

    .budget-summary-v2__status {
      display: inline-flex;
      align-items: center;
      min-height: 34px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(226, 245, 44, 0.28);
      color: var(--budget-navy);
      font-size: 0.82rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .budget-summary-v2__main {
      margin-bottom: 24px;
    }

    .budget-summary-v2__main-label {
      display: block;
      margin-bottom: 4px;
      color: #657384;
      font-size: 0.95rem;
      font-weight: 700;
    }

    .budget-summary-v2__amount {
      display: block;
      color: var(--budget-navy);
      font-size: clamp(2.35rem, 6vw, 4.2rem);
      font-weight: 850;
      line-height: 1.02;
      letter-spacing: -0.045em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .budget-summary-v2__main p {
      margin: 10px 0 0;
      color: #657384;
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .budget-progress {
      padding: 18px 0 22px;
      border-top: 1px solid #edf1f3;
      border-bottom: 1px solid #edf1f3;
    }

    .budget-progress__meta,
    .budget-progress__scale {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .budget-progress__meta {
      margin-bottom: 10px;
      color: #657384;
      font-size: 0.9rem;
    }

    .budget-progress__meta strong {
      color: var(--budget-navy);
      font-size: 0.94rem;
      font-weight: 800;
      font-variant-numeric: tabular-nums;
    }

    .budget-progress__track {
      width: 100%;
      height: 12px;
      overflow: hidden;
      border-radius: 999px;
      background: #e9eef0;
    }

    .budget-progress__fill {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(
        90deg,
        var(--budget-teal) 0%,
        var(--budget-lime) 100%
      );
      transition: width 320ms ease;
    }

    .budget-progress__scale {
      margin-top: 8px;
      color: #7a8795;
      font-size: 0.78rem;
    }

    .budget-summary-v2__details {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 18px;
    }

    .budget-detail-card {
      padding: 16px 18px;
      border-radius: 18px;
      background: var(--budget-soft);
    }

    .budget-detail-card span {
      display: block;
      margin-bottom: 5px;
      color: #6c7987;
      font-size: 0.82rem;
      font-weight: 700;
    }

    .budget-detail-card strong {
      display: block;
      color: var(--budget-navy);
      font-size: 1.25rem;
      font-weight: 850;
      line-height: 1.25;
      font-variant-numeric: tabular-nums;
    }

    .budget-summary-v2__tip {
      margin: 16px 0 0;
      color: #5f6c79;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .budget-summary-v2.is-over-budget {
      border-color: rgba(190, 63, 63, 0.28);
      background: #fffafa;
    }

    .budget-summary-v2.is-over-budget .budget-summary-v2__status {
      background: #fde6e6;
      color: #a72e2e;
    }

    .budget-summary-v2.is-over-budget .budget-progress__fill {
      background: #c94a4a;
    }

    @media (max-width: 700px) {
      .budget-summary-v2 {
        padding: 20px;
        border-radius: 22px;
      }

      .budget-summary-v2__head {
        align-items: flex-start;
        margin-bottom: 20px;
      }

      .budget-summary-v2__amount {
        font-size: clamp(2rem, 9.5vw, 3.15rem);
        letter-spacing: -0.04em;
      }

      .budget-summary-v2__details {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 430px) {
      .budget-summary-v2__amount {
        font-size: 2rem;
      }

      .budget-summary-v2__status {
        padding-inline: 10px;
        font-size: 0.76rem;
      }

      .budget-progress__meta {
        align-items: flex-end;
      }
    }
  </style>


  <style is:global>
    /* QUANTITY + BUDGET CLARITY v1 */
    .product-quantity-summary {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 5px 18px;
      align-items: center;
      margin-top: 16px;
      padding: 14px 16px;
      border: 1px solid #dce9ed;
      border-radius: 14px;
      background: #f5fafb;
    }

    .product-quantity-summary > span {
      color: #667789;
      font-size: 0.84rem;
      font-weight: 700;
      line-height: 1.4;
    }

    .product-quantity-summary > strong {
      color: #10243f;
      font-size: 0.98rem;
      font-weight: 850;
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .product-quantity-summary > small {
      grid-column: 1 / -1;
      color: #708091;
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .budget-breakdown {
      margin: 22px 0 4px;
      padding: 18px 20px;
      border: 1px solid #e1e9ec;
      border-radius: 18px;
      background: #f8faf9;
    }

    .budget-breakdown__heading {
      display: grid;
      gap: 3px;
      margin-bottom: 12px;
    }

    .budget-breakdown__heading strong {
      color: #10243f;
      font-size: 0.95rem;
      font-weight: 850;
    }

    .budget-breakdown__heading span {
      color: #748291;
      font-size: 0.78rem;
      line-height: 1.5;
    }

    .budget-breakdown__rows {
      display: grid;
    }

    .budget-breakdown__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px;
      align-items: center;
      padding: 13px 0;
      border-top: 1px solid #e8edef;
    }

    .budget-breakdown__copy {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    .budget-breakdown__category {
      color: #087fa5;
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.04em;
    }

    .budget-breakdown__copy > strong {
      color: #243a52;
      font-size: 0.9rem;
      font-weight: 750;
      line-height: 1.45;
    }

    .budget-breakdown__copy > small {
      color: #788695;
      font-size: 0.78rem;
      line-height: 1.45;
    }

    .budget-breakdown__price {
      color: #10243f;
      font-size: 0.94rem;
      font-weight: 850;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .budget-breakdown__total {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      align-items: baseline;
      padding-top: 13px;
      border-top: 1px solid #d9e3e6;
    }

    .budget-breakdown__total span {
      color: #5f6f7e;
      font-size: 0.84rem;
      font-weight: 750;
    }

    .budget-breakdown__total strong {
      color: #10243f;
      font-size: 1rem;
      font-weight: 900;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    @media (max-width: 620px) {
      .product-quantity-summary {
        grid-template-columns: 1fr;
      }

      .product-quantity-summary > strong {
        text-align: left;
      }

      .budget-breakdown {
        padding: 16px;
      }

      .budget-breakdown__row {
        grid-template-columns: 1fr;
        gap: 6px;
      }

      .budget-breakdown__price {
        justify-self: start;
      }

      .budget-breakdown__total {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
      }
    }
  </style>

</head>

  <body>
    <main class="shell builder-shell">
      <header id="builder-header" class="builder-header">
        <div class="builder-brand-bar">
          <a class="builder-brand" href="/" aria-label="PickleStart Taiwan 首頁">
            <img src="/brand/picklestart-mark.svg" alt="PickleStart Taiwan" />
          </a>
          <a class="builder-home-link" href="/">返回首頁</a>
        </div>

        <div class="progress-wrap">
          <div class="progress-meta">
            <span id="step-label">Question 1 of 6</span>
            <span id="progress-percent">17%</span>
          </div>

          <div class="progress-track">
            <div
              id="progress-bar"
              class="progress-bar"
              style="width: 16.67%"
            ></div>
          </div>
        </div>
      </header>

      <section id="builder-container">

        <!-- Q1 -->
        <section class="builder-step active" data-step="1">
          <p class="eyebrow">先了解你的經驗</p>

          <h1 class="question-title">
            你目前是哪種狀態？
          </h1>

          <div class="choice-grid" data-choice-group="experience">
            <button
              type="button"
              class="choice-card"
              data-value="first_time"
            >
              <span class="choice-icon">🌱</span>
              <span>
                <strong>第一次體驗</strong>
                <small>還沒正式開始打</small>
              </span>
            </button>

            <button
              type="button"
              class="choice-card"
              data-value="few_times"
            >
              <span class="choice-icon">🎾</span>
              <span>
                <strong>已經玩過幾次</strong>
                <small>還在熟悉這項運動</small>
              </span>
            </button>

            <button
              type="button"
              class="choice-card"
              data-value="weekly"
            >
              <span class="choice-icon">📅</span>
              <span>
                <strong>每週固定打</strong>
                <small>已經開始養成習慣</small>
              </span>
            </button>

            <button
              type="button"
              class="choice-card"
              data-value="serious"
            >
              <span class="choice-icon">🏆</span>
