        <section class="trust-panel">
          <div><span class="trust-icon">◎</span></div>
          <div>
            <strong>為什麼沒有塞更多商品？</strong>
            <p>
              我們只會顯示目前有實際參考價值的選項。
              如果你已有裝備、目前不需要，或預算根本不適合，
              我們寧可叫你先不要買。
            </p>
          </div>
        </section>

        <div class="result-actions">
          <button id="restart-button" class="primary-button" type="button">
            重新建立 Starter Kit
          </button>
          <a class="secondary-button action-link" href="/">回首頁</a>
        </div>
      </section>
    </main>

    <script>
      import { buildStarterKit } from "../logic/recommendation";
      import { trackEvent } from "../lib/analytics";
      import type {
        BuilderInput,
        BudgetTier,
        Experience,
        Goal,
        Venue
      } from "../types";

      let currentStep = 1;


      function getBuilderEntryContext() {
        const params = new URLSearchParams(
          window.location.search
        );

        const explicitSource =
          params.get("from")?.trim();

        const article =
          params.get("article")?.trim();

        if (explicitSource) {
          return {
            source: explicitSource,
            article
          };
        }

        if (!document.referrer) {
          return {
            source: "direct",
            article: null
          };
        }

        try {
          const referrer =
            new URL(document.referrer);

          if (
            referrer.origin !==
            window.location.origin
          ) {
            return {
              source: "external",
              article: null
            };
          }

          const path = referrer.pathname;

          if (path === "/" || path === "") {
            return {
              source: "home",
              article: null
            };
          }

          if (
            path === "/guide/" ||
            path === "/guide"
          ) {
            return {
              source: "guide_hub",
              article: null
            };
          }

          if (path.startsWith("/guide/")) {
            const slug =
              path
                .split("/")
                .filter(Boolean)
                .at(-1);

            return {
              source: "guide",
              article: slug ?? null
            };
          }

          if (
            path.startsWith(
              "/how-we-recommend"
            )
          ) {
            return {
              source: "recommendation_page",
              article: null
            };
          }

          if (path.startsWith("/about")) {
            return {
              source: "about",
              article: null
            };
          }

          return {
            source: "internal",
            article: null
          };
        } catch {
          return {
            source: "unknown",
            article: null
          };
        }
      }

      const builderEntry =
        getBuilderEntryContext();

      window.addEventListener(
        "load",
        () => {
          trackEvent("builder_landed");

          trackEvent(
            "builder_entry_source",
            {
              source: builderEntry.source,
              article:
                builderEntry.article ??
                undefined
            }
          );
        },
        { once: true }
      );


      let builderStarted = false;



      function markBuilderStarted() {


        if (builderStarted) return;



        builderStarted = true;


        trackEvent("builder_started");


      }

      let experience: Experience | null = null;
      let requestedPaddles = 2;
      let venue: Venue | null = null;
      let budget: BudgetTier | null = null;
      let goal: Goal | null = null;

      const steps = Array.from(
        document.querySelectorAll<HTMLElement>(".builder-step")
      );

      const builderHeader =
        document.querySelector<HTMLElement>("#builder-header");

      const stepLabel =
        document.querySelector<HTMLElement>("#step-label");

      const progressPercent =
        document.querySelector<HTMLElement>("#progress-percent");

      const progressBar =
        document.querySelector<HTMLElement>("#progress-bar");

      const nextButton =
        document.querySelector<HTMLButtonElement>("#next-button");

      const backButton =
        document.querySelector<HTMLButtonElement>("#back-button");

      const validationMessage =
        document.querySelector<HTMLElement>(
          "#validation-message"
        );

      const builderContainer =
        document.querySelector<HTMLElement>(
          "#builder-container"
        );

      const resultContainer =
        document.querySelector<HTMLElement>(
          "#result-container"
        );

      function selectChoice(
        groupName: string,
        value: string,
        button: HTMLButtonElement
      ) {
        markBuilderStarted();
        const group = document.querySelector(
          `[data-choice-group="${groupName}"]`
        );

        group
          ?.querySelectorAll(".choice-card")
          .forEach((item) =>
            item.classList.remove("selected")
          );

        button.classList.add("selected");

        if (groupName === "experience") {
          experience = value as Experience;
        }

        if (groupName === "venue") {
          venue = value as Venue;
        }

        if (groupName === "budget") {
          budget = Number(value) as BudgetTier;
        }

        if (groupName === "goal") {
          goal = value as Goal;
        }

        clearValidation();
      }

      document
        .querySelectorAll<HTMLButtonElement>(".choice-card")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const group =
              button.closest<HTMLElement>(
                "[data-choice-group]"
              );

            if (!group) return;

            selectChoice(
              group.dataset.choiceGroup ?? "",
              button.dataset.value ?? "",
              button
            );
          });
        });

      const paddleCount =
        document.querySelector<HTMLElement>(
          "#paddle-count"
        );

      document
        .querySelector("#paddle-minus")
        ?.addEventListener("click", () => {
          requestedPaddles =
            Math.max(1, requestedPaddles - 1);

          if (paddleCount) {
            paddleCount.textContent =
              String(requestedPaddles);
          }
        });

      document
        .querySelector("#paddle-plus")
        ?.addEventListener("click", () => {
          requestedPaddles =
            Math.min(4, requestedPaddles + 1);

          if (paddleCount) {
            paddleCount.textContent =
              String(requestedPaddles);
          }
        });

      let existingPaddles = 0;
      let noEquipmentConfirmed = false;

      const noEquipmentButton =
        document.querySelector<HTMLButtonElement>(
          "#no-equipment"
        );

      const equipmentCheckboxIds = [
        "has-balls",
        "has-badminton-shoes",
        "has-tennis-shoes",
        "has-court-shoes",
        "has-net"
      ];

      const existingPaddleCount =
        document.querySelector<HTMLElement>(
          "#existing-paddle-count"
        );

      function updateExistingPaddles() {
        existingPaddles = Math.min(
          existingPaddles,
          requestedPaddles
        );

        if (existingPaddleCount) {
          existingPaddleCount.textContent =
            String(existingPaddles);
        }
      }

      function renderNoEquipmentState() {
        if (!noEquipmentButton) return;

        noEquipmentButton.classList.toggle(
          "selected",
          noEquipmentConfirmed
        );

        noEquipmentButton.setAttribute(
          "aria-pressed",
          String(noEquipmentConfirmed)
        );
      }

      function clearExistingEquipment() {
        existingPaddles = 0;

        equipmentCheckboxIds.forEach((id) => {
          const input =
            document.querySelector<HTMLInputElement>(
              `#${id}`
            );

          if (input) {
            input.checked = false;
          }
        });

        updateExistingPaddles();
      }

      function hasAnyExistingEquipment(): boolean {
        return (
          existingPaddles > 0 ||
          equipmentCheckboxIds.some((id) => {
            return (
              document.querySelector<HTMLInputElement>(
                `#${id}`
              )?.checked ?? false
            );
          })
        );
      }

      function setNoEquipmentConfirmed(value: boolean) {
        noEquipmentConfirmed = value;
        renderNoEquipmentState();
      }

      noEquipmentButton?.addEventListener("click", () => {
        markBuilderStarted();

        if (noEquipmentConfirmed) {
          setNoEquipmentConfirmed(false);
        } else {
          clearExistingEquipment();
          setNoEquipmentConfirmed(true);
        }

        clearValidation();
      });

      equipmentCheckboxIds.forEach((id) => {
        const input =
          document.querySelector<HTMLInputElement>(
            `#${id}`
          );

        input?.addEventListener("change", () => {
          markBuilderStarted();

          if (input.checked) {
            setNoEquipmentConfirmed(false);
          }

          clearValidation();
        });
      });

      document
        .querySelector("#existing-paddle-minus")
        ?.addEventListener("click", () => {
          existingPaddles =
            Math.max(0, existingPaddles - 1);

          updateExistingPaddles();
        });

      document
        .querySelector("#existing-paddle-plus")
        ?.addEventListener("click", () => {
          existingPaddles =
            Math.min(
              requestedPaddles,
              existingPaddles + 1
            );

          if (existingPaddles > 0) {
            setNoEquipmentConfirmed(false);
          }

          markBuilderStarted();
          clearValidation();
          updateExistingPaddles();
        });

      function checkboxValue(id: string): boolean {
        return (
          document.querySelector<HTMLInputElement>(
            `#${id}`
          )?.checked ?? false
        );
      }

      function validateStep(): boolean {
        clearValidation();

        if (currentStep === 1 && !experience) {
          showValidation("請先選擇目前的經驗狀態。");
          return false;
        }

        if (currentStep === 3 && !venue) {
          showValidation("請先選擇主要使用場地。");
          return false;
        }

        if (
          currentStep === 4 &&
          !noEquipmentConfirmed &&
          !hasAnyExistingEquipment()
        ) {
          showValidation(
            "請選擇你已有的裝備；如果目前都沒有，請點選「我目前都沒有」。"
          );
          return false;
        }

        if (currentStep === 5 && !budget) {
          showValidation("請先選擇你的總預算。");
          return false;
        }

        if (currentStep === 6 && !goal) {
          showValidation("請先選擇你的使用目標。");
          return false;
        }

        return true;
      }

      function showValidation(message: string) {
        trackEvent(
          "builder_validation_error",
          {
            step: currentStep
          }
        );

        if (validationMessage) {
          validationMessage.textContent = message;
        }
      }

      function clearValidation() {
        if (validationMessage) {
          validationMessage.textContent = "";
        }
      }

      function renderStep() {
        steps.forEach((step) => {
          step.classList.toggle(
            "active",
            Number(step.dataset.step) === currentStep
          );
        });

        const percent =
          Math.round((currentStep / 6) * 100);

        if (stepLabel) {
          stepLabel.textContent =
            `Question ${currentStep} of 6`;
        }

        if (progressPercent) {
          progressPercent.textContent =
            `${percent}%`;
        }

        if (progressBar) {
          progressBar.style.width =
            `${percent}%`;
        }

        if (backButton) {
          backButton.disabled =
            currentStep === 1;
        }

        if (nextButton) {
          nextButton.textContent =
            currentStep === 6
              ? "看我的 Starter Kit →"
              : "下一題 →";
        }

        if (currentStep === 4) {
          updateExistingPaddles();
          renderNoEquipmentState();
        }

        clearValidation();
      }

      backButton?.addEventListener("click", () => {
        if (currentStep > 1) {
          trackEvent(
            "builder_back_clicked",
            {
              from_step: currentStep,
              to_step: currentStep - 1
            }
          );

          currentStep -= 1;
          renderStep();
        }
      });

      nextButton?.addEventListener("click", () => {
        if (!validateStep()) return;

        markBuilderStarted();
        trackEvent(`builder_q${currentStep}_completed`);

        if (currentStep < 6) {
          currentStep += 1;
          renderStep();
          return;
        }

        generateResult();
      });

      function generateResult() {
        if (
          !experience ||
          !venue ||
          !budget ||
          !goal
        ) {
          return;
        }

        const input: BuilderInput = {
          experience,
          requestedPaddles,
          venue,

          existingEquipment: {
            paddles: existingPaddles,
            balls: checkboxValue("has-balls"),

            badmintonShoes:
              checkboxValue(
                "has-badminton-shoes"
              ),

            tennisShoes:
              checkboxValue(
                "has-tennis-shoes"
              ),

            courtShoes:
              checkboxValue(
                "has-court-shoes"
              ),

            netAvailable:
              checkboxValue("has-net")
          },

          budget,
          goal
        };

        const result =


          buildStarterKit(input);



        trackEvent("builder_completed");


        trackEvent("result_viewed");

        builderContainer?.classList.add("hidden");
        builderHeader?.classList.add("hidden");

        resultContainer?.classList.remove(
          "hidden"
        );

        renderResult(result, input);

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      }

      function money(value: number) {
        return new Intl.NumberFormat(
          "zh-TW"
        ).format(Math.round(value));
      }

      function renderItems(
        targetId: string,
        items: Array<{
          label: string;
          quantity?: number;
          estimatedMin?: number;
          estimatedMax?: number;
          reason: string;
        }>
      ) {
        const target =
          document.querySelector<HTMLElement>(
            `#${targetId}`
          );

        if (!target) return;

        if (items.length === 0) {
          target.innerHTML =
            `<p class="empty-state">目前沒有項目。</p>`;
          return;
        }

        target.innerHTML = items
          .map((item) => {
            const quantity =
              item.quantity
                ? ` × ${item.quantity}`
                : "";

            const price =
              item.estimatedMin !== undefined &&
              item.estimatedMax !== undefined
                ? `
                  <p class="item-price">
                    約 NT$${money(item.estimatedMin)}
                    – ${money(item.estimatedMax)}
                  </p>
                `
                : "";

            return `
              <article class="result-item">
                <strong>
                  ${item.label}${quantity}
                </strong>

                ${price}

                <p>${item.reason}</p>
              </article>
            `;
          })
          .join("");
      }
      function categoryLabel(category: string) {
        switch (category) {
          case "paddle": return "球拍";
          case "ball": return "匹克球";
          case "shoes": return "場地鞋";
          case "net": return "球網";
          default: return category;
        }
      }

      function evidenceLabel(level: string) {
        switch (level) {
          case "manufacturer_specs": return "官方規格";
          case "hands_on": return "實際使用";
          default: return "資料整理";
        }
      }

      function displayTargetPaddleTier(input: BuilderInput) {
        const experienceTier =
          input.experience === "first_time"
            ? 1
            : input.experience === "few_times"
              ? 2
              : input.experience === "weekly"
                ? 3
                : 4;

        const goalTier =
          input.goal === "casual"
            ? 1
            : input.goal === "regular"
              ? 2
              : input.goal === "improve"
                ? 3
                : 4;

        return Math.max(
          experienceTier,
          goalTier
        );
      }

      function purchaseHighlight(
        product: ReturnType<
          typeof buildStarterKit
        >["productRecommendations"][number]["product"]
      ) {
        if (
          product.purchaseRegion === "taiwan" ||
          product.purchaseEase === 3
        ) {
          return "台灣通路可直接購買";
        }

        if (
          product.purchaseRegion === "asia" ||
          product.purchaseEase === 2
        ) {
          return "亞洲官方通路，購買相對方便";
        }

        if (
          product.purchaseRegion === "international" ||
          product.purchaseEase === 1
        ) {
          return "海外官方購買，結帳前留意運費與稅費";
        }

        return `可由 ${product.merchant} 查看目前供貨`;
      }

      function paddleProfileHighlight(
        profile:
          | "budget"
          | "forgiving"
          | "control"
          | "all_court"
          | "power"
          | undefined
      ) {
        switch (profile) {
          case "budget":
            return "入門實用，先控制第一次投入";
          case "forgiving":
            return "好上手、容錯較高";
          case "control":
            return "控制取向，重視穩定手感";
          case "all_court":
            return "全能取向，攻守較均衡";
          case "power":
            return "力量取向，偏重進攻感";
          default:
            return "定位符合目前使用情境";
        }
      }

      function productPriceLabel(
        product: ReturnType<
          typeof buildStarterKit
        >["productRecommendations"][number]["product"]
      ) {
        if (
          product.priceMin ===
          product.priceMax
        ) {
          return `約 NT$${money(
            product.priceMin
          )}`;
        }

        return `約 NT$${money(
          product.priceMin
        )}–${money(
          product.priceMax
        )}`;
      }


      function productGroupMeta(
        category: "paddle" | "ball" | "shoes" | "net",
        input: BuilderInput
      ) {
        const remainingPaddles = Math.max(
          0,
          input.requestedPaddles - input.existingEquipment.paddles
        );

        switch (category) {
          case "paddle":
            return {
              eyebrow: "PADDLE",
              title: "球拍",
              instruction: `需要 ${remainingPaddles} 支｜挑 1 款`,
              note:
                remainingPaddles > 1
                  ? `下方是在選「款式」；選定後依需求購買 ${remainingPaddles} 支。`
                  : "下方是在選適合你的球拍款式。"
            };

          case "ball":
            return {
              eyebrow: "BALLS",
              title: "匹克球",
              instruction: "至少需要 3 顆",
              note:
                "商品以實際包裝販售；下方會直接告訴你需要買幾組。"
            };

          case "shoes":
            return {
              eyebrow: "COURT SHOES",
              title: "場地鞋",
              instruction: "挑 1 款即可",
              note: ""
            };

          case "net":
            return {
              eyebrow: "NET",
              title: "球網",
              instruction: "依場地需求選 1 組",
              note:
                "只有需要自行架網時，才需要考慮購買。"
            };
        }
      }

      function priceRangeText(min: number, max: number) {
        return min === max
          ? `NT$${money(min)}`
          : `NT$${money(min)}–${money(max)}`;
      }

      function productQuantitySummary(
        product: ReturnType<
          typeof buildStarterKit
        >["productRecommendations"][number]["product"],
        input: BuilderInput
      ) {
        if (product.category === "paddle") {
          const unitsNeeded = Math.max(
            0,
            input.requestedPaddles - input.existingEquipment.paddles
          );
          const packsNeeded = Math.ceil(
            unitsNeeded / Math.max(1, product.packSize)
          );
          const totalMin = product.priceMin * packsNeeded;
          const totalMax = product.priceMax * packsNeeded;

          if (unitsNeeded <= 1) {
            return null;
          }

          return {
            label: product.packSize === 1
              ? `單支 ${priceRangeText(product.priceMin, product.priceMax)}`
              : `${product.packSize} 支入 × ${packsNeeded} 組`,
            value: `${unitsNeeded} 支合計 ${priceRangeText(totalMin, totalMax)}`,
            detail: "這個金額會納入上方的預估花費。"
          };
        }

        if (product.category === "ball") {
          const unitsNeeded = 3;
          const packsNeeded = Math.ceil(
            unitsNeeded / Math.max(1, product.packSize)
          );
          const totalMin = product.priceMin * packsNeeded;
          const totalMax = product.priceMax * packsNeeded;

          return {
            label: `${product.packSize} 入 × ${packsNeeded} 組`,
            value: `合計 ${priceRangeText(totalMin, totalMax)}`,
            detail:
              product.packSize * packsNeeded > unitsNeeded
                ? `可取得 ${product.packSize * packsNeeded} 顆，多出的留作備用。`
                : "剛好符合目前至少 3 顆的需求。"
          };
        }

        return null;
      }

      function spendBreakdownQuantityLabel(
        item: ReturnType<typeof buildStarterKit>["spendBreakdown"][number]
      ) {
        if (item.category === "paddle") {
          return item.packSize === 1
            ? `${priceRangeText(item.packPriceMin, item.packPriceMax)} × ${item.unitsNeeded} 支`
            : `${item.packSize} 支入 × ${item.packsNeeded} 組`;
        }

        if (item.category === "ball") {
          return `${item.packSize} 入 × ${item.packsNeeded} 組`;
        }

        if (item.category === "shoes") return "1 雙";
        if (item.category === "net") return "1 組";
        return `${item.packsNeeded} 組`;
      }

      function recommendationPresentation(
        recommendation: ReturnType<
          typeof buildStarterKit
        >["productRecommendations"][number],
        input: BuilderInput,
        categoryRank: number
      ) {
        const product =
          recommendation.product;

        let badge = "";
        let badgeClass = "role-alternative";
        let cardClass = "";
        let subtitle = "";
        const highlights: string[] = [];

        if (product.category === "paddle") {
          const targetTier =
            displayTargetPaddleTier(input);

          const productTier =
            product.recommendationTier ?? targetTier;

          if (productTier > targetTier) {
            badge = "升級選項";
            badgeClass = "role-upgrade";
            cardClass = "is-upgrade";
            subtitle =
              "如果想持續進步，可以往上看";

            const upgradeReason =
              targetTier <= 1
                ? "比第一次入門需求高一階，適合想直接買一支用久一點的人"
                : targetTier === 2
                  ? "比目前需求高一階，適合想持續進步的人"
                  : "比目前需求高一階，作為後續升級參考";

            highlights.push(
              upgradeReason
            );
          } else if (categoryRank === 0) {
            badge = "優先推薦";
            badgeClass = "role-primary";
            cardClass = "is-primary";
            subtitle =
              paddleProfileHighlight(
                product.paddleProfile
              );

            const fitReason =
              targetTier === 1
                ? "剛開始接觸，先從好上手又不過度投入的球拍開始"
                : targetTier === 2
                  ? "你已經有一些經驗，這個等級適合繼續使用一段時間"
                  : targetTier === 3
                    ? "你想持續進步，這個等級更符合固定打球的需求"
                    : "你目前偏高頻率或競賽導向，這個等級比較合適";

            highlights.push(
              fitReason
            );
          } else {
            badge = "另一個適合選擇";
            badgeClass = "role-alternative";
            subtitle =
              paddleProfileHighlight(
                product.paddleProfile
              );

            highlights.push(
              "同樣符合目前程度，可以再比較手感、品牌與價格"
            );
          }

          if (productTier > targetTier) {
            highlights.push(
              paddleProfileHighlight(
                product.paddleProfile
              )
            );
          } else if (product.paddleProfile) {
            const profileReason =
              paddleProfileHighlight(
                product.paddleProfile
              );

            if (
              !highlights.includes(
                profileReason
              )
            ) {
              highlights.push(
                profileReason
              );
            }
          }

          highlights.push(
            purchaseHighlight(product)
          );
        } else if (
          product.category === "ball"
        ) {
          if (product.packSize <= 3) {
            badge = "小包裝入門";
            badgeClass = "role-primary";
            cardClass = "is-primary";
            subtitle =
              "先準備夠用的數量就好";

            highlights.push(
              product.packSize === 3
                ? "清單建議至少準備 3 顆，這個包裝數量剛好"
                : `清單建議至少準備 3 顆；這款 ${product.packSize} 入裝，多出的可當備用球`
            );
          } else if (
            input.experience === "weekly" ||
            input.experience === "serious" ||
            input.goal === "improve" ||
            input.goal === "competitive"
          ) {
            badge = "固定打球適合";
            badgeClass = "role-primary";
            subtitle =
              "較多顆數，適合固定使用";

            highlights.push(
              `清單建議至少準備 3 顆；這款 ${product.packSize} 入裝，多出的可當備用球`
            );
          } else {
            badge = "實用備用量";
            badgeClass = "role-alternative";
            subtitle =
              "開始固定打球時更方便";

            highlights.push(
              `清單建議至少準備 3 顆；這款 ${product.packSize} 入裝，多出的可當備用球`
            );
          }

          highlights.push(
            input.venue === "indoor"
              ? "符合你的室內場地"
              : "符合你的戶外使用場地"
          );

          highlights.push(
            purchaseHighlight(product)
          );
        } else if (
          product.category === "shoes"
        ) {
          const pickleballSpecific =
            product.tags?.includes(
              "pickleball-shoes"
            ) ?? false;

          if (pickleballSpecific) {
            badge = "匹克球專用";
            badgeClass = "role-dedicated";
            cardClass = "is-dedicated";
            subtitle =
              "打球頻率高時值得升級";

            highlights.push(
              "你打球頻率高，匹克球專用鞋是更完整的升級選擇"
            );
          } else {
            badge = "平價實用";
            badgeClass = "role-value";
            subtitle =
              "先兼顧預算與場地需求";

            highlights.push(
              "如果想先控制預算，這雙多場地鞋可以先滿足基本場地需求"
            );
          }

          highlights.push(
            input.experience === "weekly" ||
            input.experience === "serious"
              ? "固定打球時，準備一雙合適的場地鞋會更實用"
              : "等開始固定打球後，再考慮升級也不遲"
          );

          highlights.push(
            purchaseHighlight(product)
          );
        } else {
          badge =
            categoryRank === 0
              ? "符合目前需求"
              : "另一個選擇";

          badgeClass =
            categoryRank === 0
              ? "role-primary"
              : "role-alternative";

          subtitle =
            "依目前場地需求整理";

          highlights.push(
            "符合目前使用情境"
          );

          highlights.push(
            purchaseHighlight(product)
          );
        }

        return {
          badge,
          badgeClass,
          cardClass,
          subtitle,
          highlights:
            highlights.slice(0, 3)
        };
      }

      function renderResult(
        result: ReturnType<typeof buildStarterKit>,
        input: BuilderInput
      ) {
        const resultSummary =
          document.querySelector<HTMLElement>("#result-summary");

        const budgetInsufficient = result.warnings.some(
          (warning) => warning.code === "BUDGET_INSUFFICIENT"
        );

        if (resultSummary) {
          const remainingMin = Math.max(
            0,
            input.budget - result.estimatedMaxSpend
          );

          const remainingMax = Math.max(
            0,
            input.budget - result.estimatedMinSpend
          );

          const spendMinPercent = Math.max(
            0,
            Math.round((result.estimatedMinSpend / input.budget) * 100)
          );

          const spendMaxPercent = Math.max(
            0,
            Math.round((result.estimatedMaxSpend / input.budget) * 100)
          );

          const progressPercent = Math.min(100, spendMaxPercent);

          const shortfall = Math.max(
            0,
            result.estimatedMinSpend - input.budget
          );

          const remainingText =
            remainingMax === remainingMin
              ? `NT$${money(remainingMin)}`
              : `NT$${money(remainingMin)}–${money(remainingMax)}`;

          resultSummary.innerHTML = `
            <div class="budget-summary-v2 ${budgetInsufficient ? "is-over-budget" : ""}">
              <div class="budget-summary-v2__head">
                <span class="budget-summary-v2__eyebrow">裝備預算整理</span>

                <span class="budget-summary-v2__status">
                  ${budgetInsufficient ? "超出目前預算" : "✓ 在預算內"}
                </span>
              </div>

              <div class="budget-summary-v2__main">
                <span class="budget-summary-v2__main-label">預估花費</span>

                <strong class="budget-summary-v2__amount">
                  ${priceRangeText(result.estimatedMinSpend, result.estimatedMaxSpend)}
                </strong>

                <p>
                  依你目前的 BUY NOW 裝備與優先推薦商品估算。
                </p>
              </div>

              ${
                result.spendBreakdown.length > 0
                  ? `
                    <div class="budget-breakdown">
                      <div class="budget-breakdown__heading">
                        <strong>費用怎麼算？</strong>
                        <span>以下用各分類的優先推薦商品估算</span>
                      </div>

                      <div class="budget-breakdown__rows">
                        ${result.spendBreakdown
                          .map(
                            (item) => `
                              <div class="budget-breakdown__row">
                                <div class="budget-breakdown__copy">
                                  <span class="budget-breakdown__category">
                                    ${categoryLabel(item.category)}
                                  </span>
                                  <strong>${item.productName}</strong>
                                  <small>${spendBreakdownQuantityLabel(item)}</small>
                                </div>

                                <strong class="budget-breakdown__price">
                                  ${priceRangeText(item.lineMin, item.lineMax)}
                                </strong>
                              </div>
                            `
                          )
                          .join("")}
                      </div>

                      <div class="budget-breakdown__total">
                        <span>預估合計</span>
                        <strong>
                          ${priceRangeText(result.estimatedMinSpend, result.estimatedMaxSpend)}
                        </strong>
                      </div>
                    </div>
                  `
                  : ""
              }

              <div class="budget-progress">
                <div class="budget-progress__meta">
                  <span>
                    ${budgetInsufficient ? "目前預算不足" : "預估使用預算"}
                  </span>

                  <strong>
                    ${
                      budgetInsufficient
                        ? `至少超出 NT$${money(shortfall)}`
                        : spendMinPercent === spendMaxPercent
                          ? `約 ${spendMinPercent}%`
                          : `約 ${spendMinPercent}–${spendMaxPercent}%`
                    }
                  </strong>
                </div>

                <div
                  class="budget-progress__track"
                  role="progressbar"
                  aria-label="預估預算使用比例"
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="${progressPercent}"
                >
                  <span
                    class="budget-progress__fill"
                    style="width: ${progressPercent}%"
                  ></span>
                </div>

                <div class="budget-progress__scale">
                  <span>NT$0</span>
                  <span>你的預算 NT$${money(input.budget)}</span>
                </div>
              </div>

              <div class="budget-summary-v2__details">
                <div class="budget-detail-card">
                  <span>你的總預算</span>
                  <strong>NT$${money(input.budget)}</strong>
                </div>

                <div class="budget-detail-card">
                  <span>${budgetInsufficient ? "至少還差" : "預計保留"}</span>

                  <strong>
                    ${
                      budgetInsufficient
                        ? `NT$${money(shortfall)}`
                        : remainingText
                    }
                  </strong>
                </div>
              </div>

              <p class="budget-summary-v2__tip">
                ${
                  budgetInsufficient
                    ? "可以先借用部分裝備、沿用現有裝備，或調整方案，把必要花費拉回預算內。"
                    : "不用為了把預算花完而升級不必要的裝備，剩下的可以先留著。"
                }
              </p>
            </div>
          `;
        }

        renderItems("buy-now-list", result.buyNow);
        renderItems("already-have-list", result.alreadyHave);
        renderItems("optional-later-list", result.optionalLater);
        renderItems("skip-now-list", result.skipForNow);

        const warningSection =
          document.querySelector<HTMLElement>("#warning-section");

        if (warningSection) {
          if (result.warnings.length > 0) {
            warningSection.classList.remove("hidden");
            warningSection.innerHTML = `
              <div class="section-heading">
                <div>
                  <span class="section-kicker">CHECK FIRST</span>
                  <h2>先處理這些問題</h2>
                </div>
                <span class="section-icon">⚠️</span>
              </div>

              ${result.warnings
                .map(
                  (warning) => `
                    <article class="warning-card">
                      <strong>${warning.message}</strong>
                      <ul>
                        ${warning.suggestions
                          .map((item) => `<li>${item}</li>`)
                          .join("")}
                      </ul>
                    </article>
                  `
                )
                .join("")}
            `;
          } else {
            warningSection.classList.add("hidden");
            warningSection.innerHTML = "";
          }
        }

        const productSection =
          document.querySelector<HTMLElement>("#product-section");

        const productList =
          document.querySelector<HTMLElement>("#product-list");

        if (productSection && productList) {
          if (result.productRecommendations.length === 0) {
            productSection.classList.add("hidden");
            productList.innerHTML = "";
          } else {
            productSection.classList.remove("hidden");

            const categoryOrder = [
              "paddle",
              "ball",
              "shoes",
              "net"
            ] as const;

            const groupedRecommendations =
              categoryOrder
                .map((category) => ({
                  category,
                  items:
                    result.productRecommendations
                      .map((recommendation, index) => ({
                        recommendation,
                        index
                      }))
                      .filter(
                        ({ recommendation }) =>
                          recommendation.product.category ===
                          category
                      )
                }))
                .filter(
                  (group) =>
                    group.items.length > 0
                );

            productList.innerHTML = `
              <div class="product-choice-intro">
                <strong>下面是依你的 Starter Kit 整理出的商品選項</strong>
                <span>
                  每個分類是在挑「款式」，不是每張商品卡都要買；實際數量依上方 Starter Kit 為準。
                </span>
              </div>

              ${groupedRecommendations
                .map((group) => {
                  const meta =
                    productGroupMeta(
                      group.category,
                      input
                    );

                  const cards =
                    group.items
                      .map(
                        (
                          {
                            recommendation,
                            index
                          },
                          categoryRank
                        ) => {
                          const product =
                            recommendation.product;

                          const presentation =
                            recommendationPresentation(
                              recommendation,
                              input,
                              categoryRank
                            );

                          const highlights =
                            presentation.highlights
                              .map(
                                (reason) =>
                                  `<li><span aria-hidden="true">✓</span><span>${reason}</span></li>`
                              )
                              .join("");

                          const quantitySummary =
                            productQuantitySummary(
                              product,
                              input
                            );

                          return `
                            <article
                              class="product-card product-card-v2 ${presentation.cardClass}"
                              data-choice-rank="${categoryRank + 1}"
                            >
                              <div class="product-card-top">
                                <div class="product-card-title-group">
                                  <div class="product-meta">
                                    <span class="product-category">
                                      ${categoryLabel(product.category)}
                                    </span>

                                    <span class="product-role-badge ${presentation.badgeClass}">
                                      ${presentation.badge}
                                    </span>
                                  </div>

                                  <h3>${product.name}</h3>

                                  <p class="product-positioning">
                                    ${presentation.subtitle}
                                  </p>

                                  <p class="product-merchant">
                                    來源：${product.merchant}
                                  </p>
                                </div>

                                <div class="product-price">
                                  <strong>
                                    ${productPriceLabel(product)}
                                  </strong>
                                </div>
                              </div>

                              ${
                                quantitySummary
                                  ? `
                                    <div class="product-quantity-summary">
                                      <span>${quantitySummary.label}</span>
                                      <strong>${quantitySummary.value}</strong>
                                      ${
                                        quantitySummary.detail
                                          ? `<small>${quantitySummary.detail}</small>`
                                          : ""
                                      }
                                    </div>
                                  `
                                  : ""
                              }

                              <div class="product-fit-block">
                                <p class="product-fit-heading">
                                  為什麼適合你
                                </p>

                                <ul class="product-fit-list product-fit-list-v2">
                                  ${highlights}
                                </ul>
                              </div>

                              <div class="product-card-footer">
                                <div class="product-verification">
                                  <span>${evidenceLabel(product.evidenceLevel)}</span>
                                  <span>·</span>
                                  <span>更新 ${product.lastVerified}</span>
                                </div>

                                <a
                                  class="product-link js-product-link"
                                  href="${product.affiliateUrl ?? product.sourceUrl}"
                                  target="_blank"
                                  rel="sponsored noopener noreferrer"
                                  data-product-id="${product.id}"
                                  data-category="${product.category}"
                                  data-rank="${index + 1}"
                                  data-link-type="${product.affiliateUrl ? "affiliate" : "source"}"
                                  data-recommendation-role="${presentation.badge}"
                                >
                                  ${
                                    product.affiliateUrl
                                      ? "查看目前價格 →"
                                      : "查看商品 →"
                                  }
                                </a>
                              </div>
                            </article>
                          `;
                        }
                      )
                      .join("");

                  return `
                    <section class="product-choice-group" data-product-group="${group.category}">
                      <div class="product-choice-group-heading">
                        <div>
                          <span class="product-choice-eyebrow">
                            ${meta.eyebrow}
                          </span>

                          <div class="product-choice-title-row">
                            <h3>${meta.title}</h3>
                            <span>${meta.instruction}</span>
                          </div>

                          ${
                            meta.note
                              ? `<p>${meta.note}</p>`
                              : ""
                          }
                        </div>
                      </div>

                      <div class="product-choice-list">
                        ${cards}
                      </div>
                    </section>
                  `;
                })
                .join("")}
            `;
          }
        }
      }

      document
        .querySelector("#restart-button")
        ?.addEventListener("click", () => {
          trackEvent("builder_restart_clicked");

          window.location.reload();
        });

      document.addEventListener("click", (event) => {


        const target =


          event.target as HTMLElement | null;



        const link =


          target?.closest<HTMLAnchorElement>(


            ".js-product-link"


          );



        if (!link) return;



        const isAffiliate =


          link.dataset.linkType ===


          "affiliate";



        trackEvent("product_clicked");



        trackEvent(


          isAffiliate


            ? "affiliate_clicked"


            : "product_source_clicked",


          {


            product:


              link.dataset.productId,


            category:


              link.dataset.category,


            rank:


              link.dataset.rank


          }


        );


      });



      renderStep();
    </script>
    <Analytics />
  </body>
</html>