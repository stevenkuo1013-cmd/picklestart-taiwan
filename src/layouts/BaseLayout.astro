---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";
import "../styles/public.css";

interface Props {
  title: string;
  description: string;
  pageType?: "website" | "article";
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  pageType = "website",
  datePublished,
  dateModified
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const homeURL = new URL("/", siteBase);

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${homeURL.href}#website`,
  name: "PickleStart Taiwan",
  url: homeURL.href,
  description: "給台灣匹克球新手使用的低維護 Starter Kit 推薦工具。"
};

const pageSchema =
  pageType === "article"
    ? {
        "@type": "Article",
        headline: title,
        description,
        mainEntityOfPage: canonicalURL.href,
        url: canonicalURL.href,
        inLanguage: "zh-Hant-TW",
        datePublished,
        dateModified: dateModified ?? datePublished,
        author: {
          "@type": "Organization",
          name: "PickleStart Taiwan"
        },
        publisher: {
          "@type": "Organization",
          name: "PickleStart Taiwan"
        },
        isPartOf: {
          "@id": `${homeURL.href}#website`
        }
      }
    : {
        "@type": "WebPage",
        name: title,
        description,
        url: canonicalURL.href,
        inLanguage: "zh-Hant-TW",
        isPartOf: {
          "@id": `${homeURL.href}#website`
        }
      };

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [websiteSchema, pageSchema]
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:type"
      content={pageType === "article" ? "article" : "website"}
    />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

  </head>

  <body>
    <SiteHeader />

    <main class="public-shell">
      <slot />
    </main>

    <SiteFooter />
    <Analytics />
  </body>
</html>
