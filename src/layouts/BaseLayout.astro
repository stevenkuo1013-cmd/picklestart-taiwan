---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import FunnelAnalytics from "../components/FunnelAnalytics.astro";
import "../styles/global.css";
import "../styles/public.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  pageType?: "website" | "article";
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: Array<{
    name: string;
    href: string;
  }>;
}

const {
  title,
  description,
  image = "/social/picklestart-og-v3.png",
  pageType = "website",
  datePublished,
  dateModified,
  breadcrumbs = []
} = Astro.props;

const siteBase = Astro.site ?? Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, siteBase);
const homeURL = new URL("/", siteBase);
const socialImageURL = new URL(image, siteBase);

const websiteSchema = {
  "@type": "WebSite",
  "@id": `${homeURL.href}#website`,
  name: "PickleStart Taiwan",
  url: homeURL.href,
  description: "給台灣匹克球新手使用的 6 題配裝推薦工具。"
};

const pageSchema =
  pageType === "article"
    ? {
        "@type": "Article",
        headline: title,
        description,
        image: [socialImageURL.href],
        mainEntityOfPage: canonicalURL.href,
        url: canonicalURL.href,
        inLanguage: "zh-Hant-TW",
        datePublished,
        dateModified: dateModified ?? datePublished,
        author: {
          "@type": "Organization",
          name: "PickleStart Taiwan"
        },
        publisher: {
          "@type": "Organization",
          name: "PickleStart Taiwan"
        },
        isPartOf: {
          "@id": `${homeURL.href}#website`
        }
      }
    : {
        "@type": "WebPage",
        name: title,
        description,
        url: canonicalURL.href,
        inLanguage: "zh-Hant-TW",
        isPartOf: {
          "@id": `${homeURL.href}#website`
        }
      };

const breadcrumbSchema =
  breadcrumbs.length > 0
    ? {
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: new URL(item.href, siteBase).href
        }))
      }
    : null;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    websiteSchema,
    pageSchema,
    ...(breadcrumbSchema ? [breadcrumbSchema] : [])
  ]
};
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="theme-color" content="#087fa5" />
    <meta name="robots" content="index,follow,max-image-preview:large" />

    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="google-site-verification" content="D5m435_wmPqhUL5n5RSGSkRadrJhKk6xSJ1Ih33R9DU" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:type"
      content={pageType === "article" ? "article" : "website"}
    />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="PickleStart Taiwan" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="PickleStart Taiwan｜台灣匹克球新手配裝工具與入門指南" />
    {pageType === "article" && datePublished && (
      <meta property="article:published_time" content={datePublished} />
    )}
    {pageType === "article" && (dateModified ?? datePublished) && (
      <meta
        property="article:modified_time"
        content={dateModified ?? datePublished}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>

  </head>

  <body>
    <SiteHeader />

    <main class="public-shell">
      <slot />
    </main>

    <SiteFooter />
    <Analytics />
    <FunnelAnalytics />
  </body>
</html>
